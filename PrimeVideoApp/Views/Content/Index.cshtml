@model ContentListViewModel
@{
    ViewData["Title"] = "Contenidos";
}

<h1>Contenidos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Registrar contenido</a>
    <a asp-action="Stats" class="btn btn-secondary">Procesar estadísticas</a>
</p>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-5">
        <input name="q" value="@Model.Search" class="form-control" placeholder="Buscar por título o descripción" />
    </div>
    <div class="col-md-3">
        <select name="type" class="form-select">
            <option value="">Todos los tipos</option>
            <option value="MOVIE" selected="@(Model.ContentType == "MOVIE")">Películas</option>
            <option value="TV_SHOW" selected="@(Model.ContentType == "TV_SHOW")">Series</option>
            <option value="OTHER" selected="@(Model.ContentType == "OTHER")">Otros</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-secondary w-100">Buscar</button>
    </div>
    <div class="col-md-2">
        <a asp-action="Index" class="btn btn-outline-secondary w-100">Limpiar</a>
    </div>
</form>

<p id="realtime-status" class="text-muted small">Conectando al canal en tiempo real...</p>
<div id="realtime-alert" class="alert alert-info d-none" role="alert"></div>

<div id="contentResults" data-results-url="@Url.Action("Results", "Content")">
    <partial name="_ContentList" model="Model" />
</div>

@section Scripts {
    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    <script src="~/js/content-realtime.js" asp-append-version="true"></script>
}
